# Scoped passwordless sudo for the Node-RED user (Slice 8a).
#
# The panel's only privileged operation is the USB hub power-cycle used by
# the RECOVERY CONTROLLER exec node (`sudo uhubctl ...`). This grants
# NOPASSWD for that ONE binary only — nothing else — so the flow needs no
# embedded password and the account is not given blanket root.
#
# Install:
#   1. Confirm the uhubctl path:  which uhubctl   (adjust the line below)
#   2. Confirm the Node-RED user: ps -o user= -C node-red   (usually 'pi')
#   3. sudo cp deploy/sudoers.d/busduct-nodered /etc/sudoers.d/busduct-nodered
#      sudo chmod 440 /etc/sudoers.d/busduct-nodered
#      sudo visudo -cf /etc/sudoers.d/busduct-nodered   # must say "parsed OK"
#   4. Remove any pre-existing broad NOPASSWD:ALL entry for this user.
#
# Tighten further (optional) by pinning the exact arguments, e.g.:
#   pi ALL=(root) NOPASSWD: /usr/sbin/uhubctl -l 1-1 -a off, /usr/sbin/uhubctl -l 1-1 -a on
#
# On a two-segment panel the second Nano is cycled with a different form —
# include it too, or bus2 recovery will fail with a password prompt:
#   pi ALL=(root) NOPASSWD: /usr/sbin/uhubctl -a cycle --delay 3 -l 1-1 -p 3
# (substitute the hub location/port you put in BUSDUCT_UHUBCTL_BUS2). Note the
# `-p` scoping: without it uhubctl switches every port on the hub, which on a
# two-Nano panel power-cycles both segments at once.
pi ALL=(root) NOPASSWD: /usr/sbin/uhubctl

# The Wi-Fi screen's helper (Settings -> Wi-Fi Network). A small WRAPPER, not
# nmcli itself: `NOPASSWD: /usr/bin/nmcli` would be equivalent to full root,
# since nmcli can edit any connection profile and run dispatcher scripts on
# connection events. The wrapper exposes scan/status/connect and takes the
# passphrase on stdin, so it never lands in a world-readable /proc/<pid>/cmdline.
# Install: docs/security-hardening.md §2b.
pi ALL=(root) NOPASSWD: /usr/local/sbin/busduct-wifi

# The on-screen keyboard helper (docs/pi-deployment.md §12i). Needed only where
# Node-RED does NOT run as the kiosk user — it runs `sudo -n -u pi` to reach
# that user's session bus, so this is a (pi -> pi) rule, not a root grant. Where
# Node-RED already runs as root the sudo is a passthrough and where it runs as
# pi the wrapper skips sudo entirely; the rule is here so the middle case (a
# third service account) does not fail closed with a password prompt.
#
# The wrapper takes only show|hide|toggle|status and passes NOTHING to a shell,
# so pinning the arguments adds nothing here.
pi ALL=(pi) NOPASSWD: /usr/local/sbin/busduct-osk
