#!/bin/sh
# busduct-osk - show/hide the panel's on-screen keyboard (onboard) over D-Bus.
#
# Called by the flow's "OSK Command" exec nodes with a LITERAL argument; nothing
# from the dashboard request ever reaches a shell here (see docs §12i).
#
# WHY A WRAPPER AND NOT `gdbus` STRAIGHT FROM THE EXEC NODE
# ---------------------------------------------------------
# Three environmental facts have to be got right and none of them belong in a
# flow export:
#
#   1. onboard runs in the KIOSK USER's graphical session (pi), while Node-RED
#      on these panels runs as root (see §4). A session-bus call has to be made
#      as that user, not as the caller.
#   2. The session bus is at /run/user/<uid>/bus, and $DBUS_SESSION_BUS_ADDRESS
#      is not set in a systemd service's environment.
#   3. onboard has to be RUNNING to answer. It is not D-Bus-activatable, so a
#      call against a dead instance just fails. This starts it hidden and waits
#      for the name to appear, which also means a crashed keyboard heals on the
#      next tap instead of staying dead until someone notices.
#
# Usage: busduct-osk show|hide|toggle|status|setup
set -eu

KIOSK_USER="${BUSDUCT_KIOSK_USER:-pi}"
DEST=org.onboard.Onboard
OBJ=/org/onboard/Onboard/Keyboard
IFACE=org.onboard.Onboard.Keyboard

ACTION="${1:-}"
case "$ACTION" in
  show|hide|toggle|status|setup) ;;
  *) echo "usage: $(basename "$0") show|hide|toggle|status|setup" >&2; exit 2 ;;
esac

UID_K="$(id -u "$KIOSK_USER" 2>/dev/null)" || { echo "no such user: $KIOSK_USER" >&2; exit 3; }

# Run a command inside the kiosk user's graphical session. Already that user
# (Node-RED running as pi) -> run directly; `sudo -u pi` from pi would need a
# sudoers rule for no reason and fails closed on panels that lack one.
as_kiosk() {
  if [ "$(id -u)" = "$UID_K" ]; then
    DISPLAY="${DISPLAY:-:0}" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$UID_K/bus" "$@"
  else
    sudo -n -u "$KIOSK_USER" \
      DISPLAY="${DISPLAY:-:0}" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$UID_K/bus" \
      XDG_RUNTIME_DIR="/run/user/$UID_K" \
      "$@"
  fi
}

running() { as_kiosk gdbus call --session --dest "$DEST" --object-path "$OBJ" \
              --method org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1; }

call() { as_kiosk gdbus call --session --dest "$DEST" --object-path "$OBJ" --method "$IFACE.$1" >/dev/null; }

ensure_running() {
  running && return 0
  command -v onboard >/dev/null 2>&1 || { echo "onboard is not installed (apt-get install onboard)" >&2; exit 4; }
  # setsid so it outlives this script and the exec node's process group.
  as_kiosk setsid onboard >/dev/null 2>&1 &
  # ~5 s: a cold start on a Pi 4 is about a second, and failing fast here would
  # make the first tap of the day look broken.
  i=0
  while [ "$i" -lt 50 ]; do
    running && return 0
    sleep 0.1
    i=$((i + 1))
  done
  echo "onboard did not register on the session bus within 5s" >&2
  exit 5
}

# ---------------------------------------------------------------- setup
# Applies the panel's keyboard policy. Idempotent - safe to re-run, and the
# thing to run on a new panel rather than pasting eight gsettings lines, one of
# which has to come first (see use-system-defaults below).
do_setup() {
  gset() { as_kiosk gsettings set "$@"; }

  # MUST BE FIRST. Its own schema says: "If true, get configuration from system
  # defaults first. This flag will be reset on first start." Set the keys below
  # before onboard has ever run and that first run overwrites them.
  gset org.onboard use-system-defaults false

  # Float, and stay above the fullscreen kiosk. Without force-to-top a floating
  # onboard sits BEHIND Chromium and looks like it never opened.
  gset org.onboard.window docking-enabled false
  gset org.onboard.window force-to-top true
  gset org.onboard.window window-state-sticky true

  # No permanent furniture on the operator's screen. The dashboard raises and
  # lowers the keyboard by focus, so the floating logo and the tray icon are
  # both redundant - and the logo sits over the HMI all day.
  gset org.onboard.icon-palette in-use false
  gset org.onboard show-status-icon false

  # Start hidden, so a session autostart cannot flash the keyboard up at boot
  # or leave it parked over the dashboard before anyone has touched a field.
  gset org.onboard start-minimized true

  # onboard's own auto-show stays OFF: it finds focused fields through AT-SPI,
  # which for a web page needs Chromium's accessibility tree. The dashboard
  # already knows where focus is. See docs/pi-deployment.md 12i.
  gset org.onboard.auto-show enabled false

  # FUNCTION KEYS INERT.
  #
  # `disable-keys` matches on (key id, EXACT modifier mask) - verified in
  # onboard's Keyboard.py, create_disabled_keys_set(). So one entry per modifier
  # combination; listing plain F[0-9]+ alone would still let Shift+F5 through.
  # The shipped default is only [["CTRL","LALT","F[0-9]+"]].
  #
  # LALT+F[0-9]+ is the one that matters for 12f: Alt+F4 closes the kiosk
  # window, and the Xorg lockdown cannot stop it because it is a window-manager
  # binding, not a VT switch. CTRL+LALT+F[0-9]+ is belt-and-braces over the
  # DontVTSwitch already set there.
  #
  # NOTE: these keys are still DRAWN and still animate on touch - onboard
  # rejects the keystroke in send_key_down/up, it does not hide the key. To have
  # them gone from the layout entirely, see 12i.
  gset org.onboard.lockdown disable-keys "[['F[0-9]+'],['SHIFT','F[0-9]+'],['CTRL','F[0-9]+'],['LALT','F[0-9]+'],['RALT','F[0-9]+'],['CTRL','LALT','F[0-9]+'],['LWIN','F[0-9]+']]"

  # An operator cannot quit the keyboard or open its preferences from the panel.
  # Same reasoning as the kiosk PIN gate: leaving a way out of the appliance on
  # the appliance's own screen defeats it.
  gset org.onboard.lockdown disable-quit true
  gset org.onboard.lockdown disable-preferences true

  # Touch handles stay ON: they are how a floating keyboard gets dragged on a
  # touchscreen, and the operator has to be able to move it off a field.

  echo "keyboard policy applied for user $KIOSK_USER"
  echo "restart the keyboard to pick it up:  $(basename "$0") hide; pkill onboard"
}

case "$ACTION" in
  setup) do_setup; exit 0 ;;
  status)
    running || { echo "not running"; exit 0; }
    v="$(as_kiosk gdbus call --session --dest "$DEST" --object-path "$OBJ" \
          --method org.freedesktop.DBus.Properties.Get "$IFACE" Visible 2>/dev/null || echo '')"
    case "$v" in *true*) echo visible ;; *false*) echo hidden ;; *) echo "running (state unknown)" ;; esac
    ;;
  hide)
    # Nothing to hide if it never started - and starting it just to hide it
    # would flash the keyboard on screen.
    running || exit 0
    call Hide
    ;;
  show)   ensure_running; call Show ;;
  toggle) ensure_running; call ToggleVisible ;;
esac
