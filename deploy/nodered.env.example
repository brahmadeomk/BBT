# BusductTherMo — Node-RED environment (Slice 8a).
#
# Dashboard access PINs and the kiosk-exit PIN are read from the environment
# by the flow's gate function nodes (env.get(...)) and the Exit Kiosk template
# (${BUSDUCT_KIOSK_PIN}) — they are NO LONGER hardcoded in flows_BBT.json.
# Set real values here on the Pi; DO NOT commit the filled-in file.
#
# Any gate whose variable is unset fails closed (access denied), so set every
# PIN you actually use. These are low-strength dashboard gates, not a
# substitute for the Node-RED editor adminAuth (see docs/security-hardening.md).
#
# Install (systemd):
#   sudo cp deploy/nodered.env.example /etc/busduct/nodered.env   # then edit
#   sudo chmod 600 /etc/busduct/nodered.env
#   sudo systemctl edit nodered   # add:  [Service]\n EnvironmentFile=/etc/busduct/nodered.env
#   sudo systemctl restart nodered
#
# (If Node-RED is started another way, export these in that process's env.)

BUSDUCT_PW_SYSTEM=change-me-system
BUSDUCT_PW_ALARM=change-me-alarm
BUSDUCT_PW_PARAMETERS=change-me-parameters
BUSDUCT_PW_COMMS=change-me-comms
BUSDUCT_KIOSK_PIN=change-me-kiosk

# Optional (see docs): enable the certificate-rotation channel only AFTER the
# AWS IoT policy grants the cmd/.../cert topic.
# BUSDUCT_CERT_ROTATION=1

# Optional (two-segment RS-485 only): which USB hub port each Nano sits on, so
# a wedged Nano on one segment is power-cycled without dropping the other.
#
# Format: LOCATION or LOCATION:PORT — run `sudo uhubctl` to list both, and to
# see whether this Pi can switch ports individually at all (many models gang
# all ports together). LOCATION on its own switches EVERY port on that hub, so
# with two Nanos on one hub it power-cycles both; the recovery controller warns
# when it detects that rather than doing it silently.
#
# BUSDUCT_UHUBCTL_BUS2 unset  => bus2 still raises its COMM alarm but is never
# power-cycled. BUSDUCT_UHUBCTL_BUS1 defaults to 1-1, matching the location
# hardcoded in bus1's exec node — set it only if you move bus1's hub.
# BUSDUCT_UHUBCTL_BUS1=1-1:2
# BUSDUCT_UHUBCTL_BUS2=1-1:3
